# Copia este archivo como `.env` y completa los valores.
# NUNCA subas `.env` ni compartas estos secretos.

# Base de datos PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres.host:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase (URL + claves del proyecto)
SUPABASE_URL="https://XXXXXXXX.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Servidor
PORT=4000
# Origenes permitidos por CORS (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173"