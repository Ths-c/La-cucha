# Copia este archivo como `.env` y completa los valores.
# NUNCA subas `.env` ni compartas estos secretos.

# ── Base de datos PostgreSQL (Supabase) ──
# - DATABASE_URL: conexión con pooler (puerto 6543, ?pgbouncer=true) para queries.
# - DIRECT_URL: conexión directa (puerto 5432, ?sslmode=require) para migración/seed.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Supabase (URL + claves del proyecto) ──
SUPABASE_URL="https://XXXXXXXX.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Servidor ──
PORT=4000
# Origenes permitidos por CORS (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173"

# ── Autenticación (único dueño) ──
# Credenciales para POST /api/auth/login. `AUTH_SECRET` firma los tokens (usa
# un valor largo y aleatorio, p. ej. `openssl rand -hex 32`).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
AUTH_SECRET=""
# Validez del token en segundos (por defecto 12 horas).
AUTH_TOKEN_TTL_SECONDS=43200

# ── Zona horaria / entorno ──
TIMEZONE="America/Argentina/Buenos_Aires"
NODE_ENV="development"
LOG_LEVEL="info"
